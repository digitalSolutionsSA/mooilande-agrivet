# Build output has content hashes in its file names: cache it for a year
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Images may be replaced under the same name, so cache for a week and refresh in the background
/brands/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/categories/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/team/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/*.webp
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/dssa-portals*
  X-Robots-Tag: noindex, nofollow
